{
    "name": "bea-blue/forum-refactor",
    "description": "Nested Forum Lab: nested replies with PHP, MySQL and PDO (Bramus Router + Mustache, MVC-style).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "bramus/router": "^1.6",
        "mustache/mustache": "^2.14"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    }
}
