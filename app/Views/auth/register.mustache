{{> header}}
<section class="auth-card">
  <h1>Create an account</h1>

  {{#hasErrors}}
  <div class="errors" role="alert">
    <ul>{{#errors}}<li>{{text}}</li>{{/errors}}</ul>
  </div>
  {{/hasErrors}}

  <form method="post" action="/register" class="stack">
    <input type="hidden" name="_token" value="{{csrfToken}}">

    <label for="username">Username</label>
    <input id="username" name="username" type="text" autocomplete="username" required
           minlength="3" maxlength="30" pattern="[A-Za-z0-9_]{3,30}" value="{{old.username}}"
           aria-describedby="username-hint">
    <small id="username-hint">3–30 letters, numbers or underscores.</small>

    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" value="{{old.email}}">

    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8"
           aria-describedby="password-hint">
    <small id="password-hint">At least 8 characters.</small>

    <label for="password_confirmation">Confirm password</label>
    <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required minlength="8">

    <button type="submit" class="button">Create account</button>
  </form>
  <p>Already registered? <a href="/login">Log in</a>.</p>
</section>
{{> footer}}
